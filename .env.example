# ── Agenc-IA V2 Environment Variables ───────────────
# Copy this to .env and fill in the values.
# Vercel automatically loads these from project settings.

# Required: n8n webhook for lead intake
AGENCIA_IA_N8N_LEAD_WEBHOOK_URL=https://n8n.example.com/webhook/lead-intake
AGENCIA_IA_N8N_WEBHOOK_TOKEN=change-me-to-a-secure-token

# Optional: Meta Pixel ID for tracking
# VITE_META_PIXEL_ID=1234567890

# Optional: Custom domain for canonical URL
# VITE_SITE_URL=https://agenc-ia.com.co

# ── Notes ───────────────────────────────────────────
# - The /api/lead endpoint sends leads to n8n with:
#     name, business_type, phone, email, need, service_interest,
#     source, created_at, user_agent, referer,
#     utm_source, utm_campaign, utm_medium
# - Honeypot field: company_website (hidden, rejects bots silently)
# - Meta Pixel: uncomment and set VITE_META_PIXEL_ID when ready
# - Vercel Analytics: auto-loaded via /_vercel/insights/script.js
